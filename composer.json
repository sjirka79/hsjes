{
    "name": "hsjes/flarum-oauth-seznam",
    "description": "Seznam.cz OAuth provider for FriendsOfFlarum/oauth.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "oauth",
        "seznam",
        "fof-oauth"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "flarum/core": "^1.8",
        "fof/oauth": "^1.5",
        "league/oauth2-client": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Hsjes\\OAuthSeznam\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Seznam OAuth",
            "category": "feature",
            "icon": {
                "name": "fas fa-sign-in-alt",
                "backgroundColor": "#cc0000",
                "color": "#fff"
            }
        }
    }
}
